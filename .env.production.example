APP_NAME="Turkelitemedcare"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.turkelitemedcare.com
SITE_LOCALES=en,de,ar

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true

ADMIN_NAME="Turkelitemedcare Admin"
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_UNIQUE_PASSWORD

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@turkelitemedcare.com
MAIL_FROM_NAME="Turkelitemedcare"
MAIL_ADMIN_ADDRESS=info@turkelitemedcare.com

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

SITE_THEME=clinical
SHOW_CONCEPT_SWITCHER=false

SITE_BUILD=FINAL
SITE_BUILD_LABEL="Production"
